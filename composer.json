{
    "name": "roky/laravel-route-analytics",
    "version": "1.0.0",
    "description": "Dead-simple route usage tracking for Laravel — find unused and slow routes in minutes.",
    "keywords": [
        "laravel",
        "routes",
        "analytics",
        "monitoring",
        "performance"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Roky",
            "email": "roky484812@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Roky\\LaravelRouteAnalytics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Roky\\LaravelRouteAnalytics\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Roky\\LaravelRouteAnalytics\\RouteAnalyticsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}